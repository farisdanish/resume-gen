<!DOCTYPE html>
<html lang="en"{{#if readableTypography}} class="readable-layout"{{/if}}>
<head>
  <meta charset="UTF-8">
  <title>{{basics.name}} - Resume</title>
  {{{inlinedStyles}}}
</head>
<body>
  <div class="resume-page">
    <header class="resume-header {{#if basics.headshot}}has-headshot headshot-{{basics.headshot.position}}{{/if}}">
      <div class="header-layout">
        {{#if basics.headshot}}
        <img class="headshot headshot-{{basics.headshot.shape}}" src="{{basics.headshot.dataUri}}" alt="">
        {{/if}}
        <div class="header-copy">
          <h1 class="candidate-name">{{basics.name}}</h1>
          <div class="candidate-title">{{basics.title}}</div>
          <div class="contact-bar contact-identity">
            {{#each contactIdentity}}{{#unless @first}} | {{/unless}}<span class="contact-item">{{#if href}}<a href="{{href}}">{{text}}</a>{{else}}{{text}}{{/if}}</span>{{/each}}
          </div>
          <div class="contact-bar contact-links">
            {{#each contactLinks}}{{#unless @first}} | {{/unless}}<span class="contact-item"><a href="{{href}}" target="_blank" rel="noopener noreferrer">{{text}}</a></span>{{/each}}
          </div>
        </div>
      </div>
    </header>

    {{#each orderedSections}}
    {{#if isSummary}}
    {{#if resume.basics.summary}}
    <section class="section section-summary">
      <h2 class="section-heading">{{headings.SUMMARY}}</h2>
      <p class="summary-text">{{resumeText resume.basics.summary}}</p>
    </section>
    {{/if}}
    {{/if}}

    {{#if isExperience}}
    {{#if resume.work.length}}
    <section class="section section-experience">
      <h2 class="section-heading">{{headings.EXPERIENCE}}</h2>
      {{#each resume.work}}
      <div class="experience-item">
        <div class="item-header">
          <div class="item-title-group">
            <span class="item-role">{{this.role}}</span>
            <span class="contact-sep">|</span>
            <span class="item-company">{{this.company}}</span>
          </div>
          <div class="item-meta">
            {{#if this.location}}{{this.location}} • {{/if}}
            {{this.start}} – {{#if this.end}}{{this.end}}{{else}}Present{{/if}}
          </div>
        </div>
        <ul class="highlight-list">
          {{#each this.highlights}}
          <li>{{resumeText this}}</li>
          {{/each}}
        </ul>
      </div>
      {{/each}}
    </section>
    {{/if}}
    {{/if}}

    {{#if isEducation}}
    {{#if resume.education.length}}
    <section class="section section-education">
      <h2 class="section-heading">{{headings.EDUCATION}}</h2>
      {{#each resume.education}}
      <div class="education-item">
        <div class="edu-title-group">
          <span class="edu-degree">{{this.degree}}</span>
          <span class="contact-sep">|</span>
          <span class="edu-institution">{{this.institution}}</span>
        </div>
        <div class="edu-meta">
          {{#if this.start}}{{this.start}} – {{/if}}{{#if this.end}}{{this.end}}{{else}}Present{{/if}}
        </div>
      </div>
      {{/each}}
    </section>
    {{/if}}
    {{/if}}

    {{#if isSkills}}
    {{#if resume.skills.length}}
    <section class="section section-skills">
      <h2 class="section-heading">{{headings.SKILLS}}</h2>
      {{#each resume.skills}}
      <div class="skill-category-row">
        <span class="skill-cat-name">{{this.category}}:</span>
        <span class="skill-cat-items">
          {{#each this.items}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}
        </span>
      </div>
      {{/each}}
    </section>
    {{/if}}
    {{/if}}

    {{#if isCertifications}}
    {{#if resume.certifications.length}}
    <section class="section section-certifications">
      <h2 class="section-heading">{{headings.CERTIFICATIONS}}</h2>
      <div class="certs-inline">
        {{#each resume.certifications}}{{this}}{{#unless @last}} • {{/unless}}{{/each}}
      </div>
    </section>
    {{/if}}
    {{/if}}

    {{#if isProjects}}
    {{#if resume.projects.length}}
    <section class="section section-projects">
      <h2 class="section-heading">{{headings.PROJECTS}}</h2>
      {{#each resume.projects}}
      <div class="project-item">
        <div class="project-heading">
        <span class="project-title">{{this.title}}</span>
        {{#if this.stack.length}}
          <span class="contact-sep">|</span>
          <span class="edu-meta">{{#each this.stack}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</span>
        {{/if}}
        {{#if this.link}}<div class="project-link"><a href="{{this.link}}" target="_blank" rel="noopener noreferrer">{{this.link}}</a></div>{{/if}}
        </div>
        <p class="project-desc">{{resumeText this.description}}</p>
      </div>
      {{/each}}
    </section>
    {{/if}}
    {{/if}}

    {{#if isReferences}}
    {{#if resume.references}}
    <section class="section section-references">
      <h2 class="section-heading">{{headings.REFERENCES}}</h2>
      {{#if resume.references.entries}}
      <div class="references-grid">
        {{#each resume.references.entries}}
        <div class="reference-item">
          <span class="reference-name">{{this.name}}</span>
          {{#if this.title}}<span> — {{this.title}}</span>{{/if}}
          {{#if this.organization}}<span>, {{this.organization}}</span>{{/if}}
          <div class="reference-contact">
            {{#if this.email}}{{this.email}}{{/if}}
            {{#if this.phone}}{{#if this.email}} • {{/if}}{{this.phone}}{{/if}}
          </div>
        </div>
        {{/each}}
      </div>
      {{else}}
      <p class="references-request">References available upon request.</p>
      {{/if}}
    </section>
    {{/if}}
    {{/if}}
    {{/each}}
  </div>
</body>
</html>
